{
  "$description": "Runner Coach design tokens (design system 'Lintas'). Format: W3C Design Tokens (DTCG). Sumber kebenaran tunggal untuk warna, tipe, ukuran dan gerak. Kode di packages/ui dihasilkan dari file ini.",
  "$version": "0.1.0",
  "color": {
    "$type": "color",
    "palette": {
      "$description": "Palet mentah dari brief (foto 1 dan 2). Komponen tidak memakai ini langsung; pakai token semantik di bawah.",
      "cream": { "$value": "#FFF9F2" },
      "white": { "$value": "#FFFFFF" },
      "orange": { "$value": "#F26B38" },
      "charcoal": { "$value": "#242C32" },
      "peach": { "$value": "#E9B79D" },
      "forest": { "$value": "#477B63" },
      "mint": { "$value": "#70D6B3" },
      "sand": { "$value": "#F2C66D" },
      "coral": { "$value": "#FF806E" },
      "lavender": { "$value": "#A6B8FF" }
    },
    "bg": { "$value": "{color.palette.cream}", "$description": "Latar layar (kertas hangat, bukan putih atau abu-abu)" },
    "surface": { "$value": "{color.palette.white}", "$description": "Kartu, sheet, input" },
    "surface-sunken": { "$value": "#F6EDE3", "$description": "Segmented control, kotak statistik, track progress" },
    "text": { "$value": "{color.palette.charcoal}" },
    "text-muted": { "$value": "#5E6670", "$description": "Teks kedua; >= 4.5:1 di bg dan surface" },
    "line": { "$value": "#EADFD3", "$description": "Border dekoratif dan pemisah" },
    "line-strong": { "$value": "#858C94", "$description": "Border input dan kontrol (>= 3:1 di bg)" },
    "primary": { "$value": "{color.palette.orange}", "$description": "Satu aksi utama per layar, progres aktif" },
    "on-primary": { "$value": "{color.palette.charcoal}", "$description": "Teks di atas primary. Putih tidak dipakai (3.03:1, gagal)" },
    "primary-ink": { "$value": "#CB410D", "$description": "Primary sebagai teks atau ikon di bg terang (link, angka sorotan)" },
    "accent": { "$value": "{color.palette.peach}", "$description": "Sorotan lembut, zona easy, fase base" },
    "accent-ink": { "$value": "#B35828" },
    "success": { "$value": "{color.palette.forest}", "$description": "Target tercapai, progres positif, minggu tuntas" },
    "on-success": { "$value": "{color.palette.white}" },
    "focus-ring": { "$value": "{color.palette.charcoal}" },
    "status": {
      "$description": "Status kepatuhan plan. Warna isi (pastel) selalu dengan teks gelap; untuk teks/ikon pakai varian -ink.",
      "on-track": { "$value": "{color.palette.mint}", "$description": "Sesuai plan" },
      "on-track-ink": { "$value": "#247F60" },
      "attention": { "$value": "{color.palette.sand}", "$description": "Perhatian: RPE tinggi, 1 latihan terlewat" },
      "attention-ink": { "$value": "#95680D" },
      "behind": { "$value": "{color.palette.coral}", "$description": "Tertinggal: >= 2 latihan terlewat atau plan diulang" },
      "behind-ink": { "$value": "#C42F1C" },
      "recovery": { "$value": "{color.palette.lavender}", "$description": "Recovery: cutback week, Return to run, plan dijeda" },
      "recovery-ink": { "$value": "#3861FF" },
      "on-status": { "$value": "{color.palette.charcoal}" }
    },
    "zone": {
      "$description": "Skala panas intensitas: makin berat makin panas. Kecerahan menurun berurutan sehingga tetap terbaca tanpa membedakan hue. Selalu disertai label teks.",
      "recovery": { "$value": "{color.palette.lavender}", "$description": "Istirahat, recovery, jalan" },
      "easy": { "$value": "{color.palette.peach}", "$description": "Easy, run-walk, strides, segmen drill" },
      "long": { "$value": "#D9946F", "$description": "Long run" },
      "tempo": { "$value": "{color.palette.orange}", "$description": "Tempo, threshold" },
      "interval": { "$value": "#B4361A", "$description": "Interval (bara)" },
      "strength": { "$value": "{color.palette.charcoal}", "$description": "Strength, core, mobility (fase 2). Charcoal = besi, tidak bentrok dengan skala panas" },
      "on-recovery": { "$value": "{color.palette.charcoal}" },
      "on-easy": { "$value": "{color.palette.charcoal}" },
      "on-long": { "$value": "{color.palette.charcoal}" },
      "on-tempo": { "$value": "{color.palette.charcoal}" },
      "on-interval": { "$value": "{color.palette.white}" },
      "on-strength": { "$value": "{color.palette.cream}" }
    },
    "phase": {
      "base": { "$value": "{color.zone.easy}" },
      "build": { "$value": "{color.zone.long}" },
      "peak": { "$value": "{color.zone.tempo}" },
      "taper": { "$value": "{color.zone.recovery}" }
    },
    "rpe": {
      "$description": "Latar tombol RPE terpilih, mengikuti skala panas. Teks: on-* zona yang sama.",
      "1-3": { "$value": "{color.zone.easy}" },
      "4-6": { "$value": "{color.zone.long}" },
      "7-8": { "$value": "{color.zone.tempo}" },
      "9-10": { "$value": "{color.zone.interval}" }
    },
    "dark": {
      "$description": "Layar Timer (selalu gelap) dan mode gelap fase lanjut.",
      "bg": { "$value": "#161B1F" },
      "surface": { "$value": "{color.palette.charcoal}" },
      "text": { "$value": "{color.palette.cream}" },
      "text-muted": { "$value": "#A9B0B7" },
      "line": { "$value": "#343D44" },
      "zone-interval": { "$value": "#E0522E", "$description": "Interval di latar gelap; #B4361A terlalu gelap di sini (2.88:1)" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Bricolage Grotesque", "system-ui", "sans-serif"], "$description": "Judul dan angka besar. Selalu dengan tnum untuk angka" },
      "ui": { "$value": ["Plus Jakarta Sans", "system-ui", "sans-serif"], "$description": "Teks, label, tombol. Typeface buatan foundry Jakarta" }
    },
    "feature": {
      "numeric": { "$value": "\"tnum\" 1", "$description": "Digit lebar sama; wajib untuk timer, pace, jarak" }
    }
  },
  "typography": {
    "$type": "typography",
    "timer": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "88px", "fontWeight": 800, "lineHeight": 1, "letterSpacing": "-0.03em" } },
    "number-xl": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "64px", "fontWeight": 800, "lineHeight": 1, "letterSpacing": "-0.03em" } },
    "number-md": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "24px", "fontWeight": 700, "lineHeight": 1.1, "letterSpacing": "-0.01em" } },
    "display": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "36px", "fontWeight": 800, "lineHeight": 1.05, "letterSpacing": "-0.03em" } },
    "title": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "28px", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-0.02em" } },
    "heading": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "18px", "fontWeight": 700, "lineHeight": 1.3, "letterSpacing": "0" } },
    "body": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "16px", "fontWeight": 500, "lineHeight": 1.5, "letterSpacing": "0" } },
    "button": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "17px", "fontWeight": 700, "lineHeight": 1, "letterSpacing": "0" } },
    "label": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "13px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "0.01em" } },
    "bib": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "13px", "fontWeight": 800, "lineHeight": 1, "letterSpacing": "0.08em" }, "$description": "Label tipe latihan gaya nomor dada, huruf kapital" },
    "caption": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "12px", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "0.01em" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "screen-x": { "$value": "20px", "$description": "Padding kiri-kanan layar HP" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "10px", "$description": "Input, sel kalender" },
    "md": { "$value": "16px", "$description": "Kotak statistik, opsi" },
    "lg": { "$value": "24px", "$description": "Kartu" },
    "sheet": { "$value": "32px", "$description": "Bottom sheet (sudut atas)" },
    "stadium": { "$value": "999px", "$description": "Bentuk lintasan: tombol, chip, progress bar" },
    "bib": { "$value": "6px", "$description": "Label bib" }
  },
  "size": {
    "$type": "dimension",
    "touch-min": { "$value": "44px" },
    "button-primary": { "$value": "60px" },
    "button-secondary": { "$value": "48px" },
    "input": { "$value": "52px" },
    "chip": { "$value": "40px", "$description": "Tinggi visual; area sentuh tetap touch-min" },
    "icon": { "$value": "24px" },
    "track-stroke": { "$value": "10px", "$description": "Tebal garis cincin oval progres" },
    "content-max": { "$value": "640px" }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "control": { "$value": "1.5px" },
    "selected": { "$value": "2.5px" }
  },
  "shadow": {
    "$type": "shadow",
    "card": { "$value": { "color": "#242C321A", "offsetX": "0px", "offsetY": "2px", "blur": "0px", "spread": "0px" }, "$description": "Bayangan keras pendek ke bawah (bukan blur lembut), memberi kesan kartu kertas" },
    "raised": { "$value": { "color": "#242C3226", "offsetX": "0px", "offsetY": "4px", "blur": "0px", "spread": "0px" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms", "$description": "Hanya untuk perayaan (minggu tuntas)" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "stride": { "$value": [0.34, 1.4, 0.64, 1], "$description": "Sedikit memantul, untuk progres bertambah. Dimatikan saat reduce-motion" }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "tablet": { "$value": "600px" },
    "desktop": { "$value": "1024px" }
  }
}
