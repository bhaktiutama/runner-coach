{
  "name": "runco-video",
  "private": true,
  "description": "Marketing videos for RunCo (Remotion). Not part of the app build. See docs/store/04-VIDEO-PLAN.md",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:v1": "remotion render src/index.ts V1-Promo out/runco-promo-1080p.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell --crf=18",
    "render:v1p": "remotion render src/index.ts V1-Portrait out/runco-promo-9x16.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell --crf=18",
    "render:v2": "remotion render src/index.ts V2-Social out/runco-social-9x16.mp4 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1243/chrome-headless-shell-linux64/chrome-headless-shell --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
